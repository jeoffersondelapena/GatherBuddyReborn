<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Fork only. Compiled from the plugin's own source so the tests exercise the shipped code: the plugin
		     targets net10.0-windows and needs the game, so it cannot be referenced as an assembly on a Mac.
		     Everything in ForkLogic is free of game and plugin types for that reason. -->
		<Compile Include="..\GatherBuddy\ForkLogic\*.cs" LinkBase="ForkLogic" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

</Project>
